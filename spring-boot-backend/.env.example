# ========================================================
# AI Study Buddy - Environment Configuration Template
# Copy this file to .env or export these variables in your shell / IDE.
# NEVER commit real production credentials to version control.
# ========================================================

# Google Gemini Generative AI API Key & Model
# Obtain key for free from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/ai_study_buddy?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Authentication Secret (HS256 minimum 256-bit key = at least 32 characters)
JWT_SECRET=your_secure_random_jwt_secret_at_least_32_characters_long
JWT_EXPIRATION_MS=604800000

# Backend Server Port
SERVER_PORT=8080

# Frontend CORS Allowed Origins (Comma-separated, no trailing slashes or wildcards)
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080
